---
import Container from "@components/container.astro";
import NewsLetter from "@components/EmailFormhu.astro";
import Pricing from "@components/gocardless-pricing.astro";
import Link from "@components/ui/link.astro";
import Layout from "@layouts/Layout.astro";
import type { PaddleProduct } from "@pages/gocardless.astro";
import { changeLanguage } from "i18next";
changeLanguage("hu");

const productID1 = import.meta.env.PRODUCT_ID_4;
const productID2 = import.meta.env.PRODUCT_ID_5;

const headersList = {
  Accept: "*/*",
  Authorization: `Bearer ${import.meta.env.PADDLE_API_KEY}`,
};

const fetchUrl = (
  import.meta.env.PUBLIC_ENVIRONMENT === "development"
    ? "https://sandbox-api.paddle.com/prices"
    : "https://api.paddle.com/prices"
) as string;

const response = await fetch(fetchUrl, {
  method: "GET",
  headers: headersList,
});

const responseFromPaddle = await response.text();

const data = JSON.parse(responseFromPaddle).data.filter(
  (item: PaddleProduct) =>
    item.status === "active" && item.product_id === productID1,
) as PaddleProduct[];

const pricingData = [
  {
    name: "ERPNext 25",
    price: "€10",
    popular: true,
    features: [
      "CPU Time per day: 2 Hours",
      "Database: 1 GB",
      "Storage: 25 GB",
      "Automated backups",
      "Offsite backups",
      "GoCardless Integration",
    ],
    button: {
      text: "Order now!",
      link: "path_header.primary_button_text",
    },
    paddlePriceId: data[0].id,
    quantity: 1,
  },
];
---

<Layout lang="hu" title="ERPNext tárhely és üzemeltetés ">
  <Container>
    <div class="px-5 pt-10">
      <div
        class="flex justify-between items-center text-[#192734] dark:text-white h-auto md:flex-row flex-col pb-12 md:pb-1"
      >
        <div class="flex flex-col h-full justify-center basis-3/5">
          <h1 class="text-4xl md:text-5xl leading-none font-semibold">
            ERPNext tárhely és üzemeltetés
          </h1>
          <h2 class="text-xl text-[#192734] dark:text-white my-4">
            ERPNext tárhely a felhőben.
          </h2>
          <div>
            <Link href="/hu/kapcsolat">Beszéljünk!</Link>
          </div>
        </div>
        <div class="mt-10 md:mt-0 basis-1/2 overflow-hidden">
          <img class="w-full" src="/images/erpnext-hosting.png" alt="" />
        </div>
      </div>

      <section>
        <div
          class="grid md:grid-cols-1 gap-10 mx-auto place-items-center max-w-4xl mt-20"
          id="pricing"
        >
          {
            pricingData.map((item, index) => (
              <Pricing key={index} plan={item} />
            ))
          }
        </div>
      </section>

      <div class="flex flex-col items-center">
        <section class="py-8 px-4 md:w-2/3 text-[#192734] dark:text-white">
          <h2 class="font-bold text-3xl mb-10">
            Kényelmes és egyszerű ERPNext tárhely és üzemeltetési támogatás
          </h2>
          <p class="list-disc text-[17px] leading-7 space-y-5]">
            Az ERPNext üzemeltetése szakértelem mellett speciális technikai
            feltételeket is megkíván. Több éves ERPNext használat alatt sok
            partnerrel való együttműködés után megtaláltuk azt az ERPNext
            partnert, akit szívesen ajánlunk. Az ERPNext osztott tárhelyen nem
            üzemeltethető, a menedzselt VPS és szerver szolgáltatások pedig
            jellemzően magasabb árkategóriába tartoznak. Ezért örömmel mutatjuk
            be az ERPNext felhőszolgáltatót, amelyen a monolithon.com, a magyar
            ERPNext népszerűsítő oldal is fut.
            <br /><br />
             Az ERPNext fejlesztői által fejlesztett, üzemeltetett és
            optimalizált platform a Frappe Cloud szerintünk a legjobb ERPNext
            hoszting szolgáltató, ezért ajánljuk és használjuk.
          </p>

          <section id="contact-form-2">
            <NewsLetter />
          </section>
        </section>
      </div>
    </div>
  </Container>
</Layout>
